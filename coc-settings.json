{
  "languageserver": {
    "pyls": {
      "command": "pyls",
      "rootPatterns": [".git/"],
      "filetypes": ["python", "py"]
    },
    "fortls": {
      "command": "fortls",
      "rootPatterns": [".git/"],
      "filetypes": ["fortran", "f90"]
    },
    "clangd": {
      "command": "clangd-6.0",
      "rootPatterns": [".git/"],
      "filetypes": ["c", "cpp"]
    },
    "arduino": {
      "command": "arduino-language-server",
      "args": [
        "-cli",
        "arduino-cli",
        "-fqbn",
        "arduino:avr:uno",
        "-clangd",
        "clangd"
      ],
      "filetypes": ["arduino", "c", "cpp"],
      "rootPatterns": [".git/", "*.ino"]
    },
  },
  "diagnostic.enable": false,
  "diagnostic.locationlist": false
}
