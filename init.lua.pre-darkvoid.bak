  transparent = true,
  colors = {
    theme = {
      dragon = {
        ui = {
          fg = '#ccccce', fg_dim = '#cf98c1', fg_reverse = '#002a3a',
          bg_dim = '#0d0d1b', bg_gutter = 'none',
          bg_m3 = '#08080f', bg_m2 = '#0a0a16', bg_m1 = '#0d0d1b',
          bg = '#0d0d1b', bg_p1 = '#16162b', bg_p2 = '#1e1e38',
          special = '#9a77b1', whitespace = '#3a3a5a', nontext = '#3a3a5a',
          bg_visual = '#002a3a', bg_search = '#98218e',
          pmenu = {
            fg = '#ccccce', fg_sel = 'none',
            bg = '#002a3a', bg_sel = '#94469b',
            bg_thumb = '#94469b', bg_sbar = '#002a3a',
          },
          float = {
            fg = '#ccccce', bg = 'none',
            fg_border = '#94469b', bg_border = 'none',
          },
        },
        syn = {
          string = '#789aba', variable = 'none',
          number = '#f2a297', constant = '#f2a297',
          identifier = '#cf98c1', parameter = '#b3879f',
          fun = '#fb6e93', statement = '#9a77b1', keyword = '#9a77b1',
